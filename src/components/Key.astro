---
/**
 * Modifier key label that shows both Mac and PC text; CSS picks which span is visible.
 * alt switches ⌘/Ctrl to ⌥/Alt. Entities keep the Apple symbols portable in markup.
 */
interface Props { alt?: boolean }
const { alt = false } = Astro.props;
---
<span data-mac>{alt ? <>&#8997;</> : <>&#8984;</>}</span><span data-pc>{alt ? 'Alt' : 'Ctrl'}</span>
