---
// Shortcuts are proposals from the design phase; confirm against the extension's manifest.
// A seed note ("w2" in scripts/notes/seeds.ts) is pinned to this section to say so, floating in its top
// padding; the <noscript> line covers no-JS visitors.
import Key from '../Key.astro';
---
<section id="shortcuts" class="wrap shortcuts" data-scope="shortcuts">
  <div class="col">
    <div class="kicker">Keyboard shortcuts</div>
    <h2 class="h2-sub">For the mouse-averse.</h2>
    <noscript><p class="status">Proposed keys. They may change while the extension is being built.</p></noscript>
    <table class="table">
      <tbody>
        <tr><td>Add a note where you click</td><td class="keys"><Key /> + click</td></tr>
        <tr><td>New note in the middle of the view</td><td class="keys"><Key alt /> + Shift + N</td></tr>
        <tr><td>Save and switch to preview</td><td class="keys"><Key /> + Enter</td></tr>
        <tr><td>Stop editing</td><td class="keys">Esc</td></tr>
        <tr><td>Show or hide notes on this site</td><td class="keys"><Key alt /> + Shift + H</td></tr>
      </tbody>
    </table>
    <div class="fine">Change any of them at <code>chrome://extensions/shortcuts</code>.</div>
  </div>
  <div id="browsers" class="col">
    <div class="kicker">Browser support</div>
    <h2 class="h2-sub">Chrome, and its cousins.</h2>
    <ul class="browsers">
      <li><span class="name">Chrome</span><span class="tag tag-accent">Supported</span></li>
      <li><span class="name">Microsoft Edge</span><span class="tag tag-accent">Supported</span></li>
      <li>
        <span class="stack"><span class="name">Brave</span><span class="sub">Notes work; browser sync still being tested. Drive backup covers you.</span></span>
        <span class="tag tag-neutral">Works</span>
      </li>
    </ul>
    <div class="fine">All three install from the Chrome Web Store. Firefox and Safari: not yet.</div>
  </div>
</section>

<style>
  .shortcuts {
    position: relative;
    padding-top: 120px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 64px;
    align-items: start;
  }
  .col { display: flex; flex-direction: column; gap: 20px; }
  .keys {
    text-align: right;
    white-space: nowrap;
    font: 12px ui-monospace, Menlo, monospace;
  }
  .fine { font-size: 13px; color: var(--color-neutral-700); }
  .status { margin: 0; font-size: 14px; line-height: 1.6; font-style: italic; color: var(--color-neutral-700); text-wrap: pretty; }
  code { font: 12px ui-monospace, Menlo, monospace; }
  .browsers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-divider);
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid var(--color-divider);
  }
  .name { font: 600 20px/1.2 var(--font-heading); flex: 1; }
  .stack { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .sub { font-size: 12px; color: var(--color-neutral-700); }
</style>
