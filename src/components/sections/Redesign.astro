---
// "Websites redesign" demo: a small mock site with two layouts of the same height. The notes
// island (scripts/notes/board.ts) plays the redesign once when this scrolls into view, then
// rings the button (data-demo-action) that replays it. [data-flip] marks each block that is
// animated between layouts ("move" travels, "fade" cross-fades); [data-scope] marks the two that seed notes are pinned to.

const steps = [
  ['1', 'Grind', 'Medium-fine, like table salt.'],
  ['2', 'Bloom', 'Thirty seconds, just wet.'],
  ['3', 'Pour', 'Slow circles, keep it covered.'],
];
---
<section id="redesign" class="wrap redesign">
  <div class="side">
    <div class="kicker">Built for the real web</div>
    <h2 class="h2">Websites redesign. Your notes don&rsquo;t mind.</h2>
    <p class="prose">Each note remembers the bit of the page it&rsquo;s stuck to, plus where it sat. When the layout changes, every note moves with what it&rsquo;s pinned to and settles into its new spot.</p>
    <div class="actions">
      <button class="btn btn-primary" type="button" data-demo-action="redesign" disabled>Undo the redesign</button>
    </div>
    <div class="status" data-demo-status aria-live="polite">Redesigned. Both notes followed what they were pinned to.</div>
  </div>
  <div class="browser">
    <div class="browser-bar">
      <span class="browser-dots" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="browser-url">brew.yush.dev/filter-coffee</span>
    </div>
    <div class="page" data-scope="demo" data-demo>
      <div class="mock">
        <div class="m-nav" data-flip="move">
          <span class="m-logo">Brew.</span>
          <span>Guides</span><span>Gear</span><span>Beans</span>
          <span class="m-cart">Cart</span>
        </div>
        <!-- A placeholder on purpose: the mock is about layout, so the photo is a skeleton block. -->
        <div class="m-img" data-flip="fade" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" /></svg>
          <span>photo: pour-over on a scale</span>
        </div>
        <div class="m-head" data-flip="move">A very serious guide to filter coffee</div>
        <p class="m-para" data-flip="move" data-scope="demo-para">Weigh it. Fifteen grams of coffee to two hundred and forty of water is a fair place to start. Then change one thing at a time and taste the difference.</p>
        <!-- A span, not a button: it is part of the mock, and notes can be stuck on it. -->
        <span class="m-buy" data-flip="move" data-scope="demo-buy">Buy the kettle &middot; $48</span>
        <div class="m-steps">
          {steps.map(([n, title, body]) => (
            <div class="m-step" data-flip="fade">
              <span class="m-num">{n}</span>
              <span class="m-text"><b>{title}</b><span class="m-body">{body}</span></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .redesign {
    padding-top: 120px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 56px;
    align-items: start;
  }
  .side { display: flex; flex-direction: column; gap: 20px; }
  .prose { font-size: 16px; line-height: 1.65; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .actions .btn { position: relative; }
  /* Keep the control visually steady while the automatic redesign runs, then point it out once. */
  .actions .btn:disabled { opacity: 1; cursor: default; }
  .actions .btn.is-ringing::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1.5px solid var(--color-accent);
    border-radius: inherit;
    pointer-events: none;
    animation: cta-ring 0.7s ease-out 500ms;
    opacity: 0;
  }
  .status {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-neutral-800);
    padding-top: 14px;
    border-top: 1px solid var(--color-divider);
    /* Room for three lines, so swapping the message never changes the section's height. */
    min-height: calc(14px + 4.5em);
  }
  .browser { box-shadow: var(--shadow-md); }

  /* The mock site. .page has a fixed height and both layouts are grids that fill it, so a
     redesign never changes the height of the section. */
  .page {
    position: relative;
    height: 440px;
    padding: 18px 20px;
    container-type: inline-size;
    font-family: system-ui, sans-serif;
    color: #2a2a2a;
  }
  .mock {
    height: 100%;
    display: grid;
    gap: 12px 22px;
    align-items: start;
    grid-template-columns: minmax(0, 1fr) 170px;
    grid-template-rows: 30px auto auto 1fr;
    grid-template-areas:
      'nav nav'
      'head steps'
      'para steps'
      'buy steps';
  }
  .m-nav {
    grid-area: nav;
    align-self: stretch;
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e6e3dd;
    font-size: 12px;
  }
  .m-logo { margin-right: auto; font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
  .m-cart { padding: 2px 9px; border-radius: 10px; background: #2a2a2a; color: #fdfdfc; }
  .m-img {
    grid-area: img;
    display: none;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 6px;
    background: repeating-linear-gradient(135deg, #ece5d8 0 8px, #e4dccd 8px 16px);
    color: #5d4f38;
    font: 11px ui-monospace, Menlo, monospace;
  }
  .m-img svg { flex: none; }
  .m-head { grid-area: head; font-size: 24px; font-weight: 700; letter-spacing: -0.015em; line-height: 1.15; }
  .m-para { grid-area: para; position: relative; margin: 0; font-size: 14px; line-height: 1.55; border-radius: 2px; }
  .m-buy {
    grid-area: buy;
    justify-self: start;
    position: relative;
    display: flex;
    padding: 9px 16px;
    border-radius: 6px;
    background: #2a2a2a;
    color: #fdfdfc;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .m-steps { grid-area: steps; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
  .m-step {
    display: flex;
    gap: 9px;
    min-width: 0;
    padding: 9px 11px;
    border: 1px solid #e6e3dd;
    border-radius: 6px;
    background: #faf8f4;
    overflow: hidden;
  }
  .m-num { font-size: 18px; font-weight: 700; line-height: 1; color: #8a7d66; }
  .m-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; font-size: 12.5px; }
  .m-text b { font-weight: 650; }
  .m-body { font-size: 11.5px; line-height: 1.35; color: #5d5a55; }

  /* Redesigned: a photo arrives, the button crosses the page, the steps become a row. */
  .page.is-redesigned .mock {
    /* Same columns as the original layout, so the paragraph keeps its width and never re-wraps. */
    grid-template-columns: minmax(0, 1fr) 170px;
    grid-template-rows: 30px 96px auto 1fr auto;
    grid-template-areas:
      'nav nav'
      'img img'
      'head head'
      'para buy'
      'steps steps';
  }
  .page.is-redesigned .m-img { display: flex; }
  .page.is-redesigned .m-head { font-size: 19px; }
  .page.is-redesigned .m-buy { justify-self: end; }
  .page.is-redesigned .m-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  /* Narrow browser frame: one column in both layouts, and the step cards lose their second line. */
  @container (max-width: 400px) {
    .mock {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 30px auto auto auto 1fr;
      grid-template-areas: 'nav' 'head' 'para' 'buy' 'steps';
    }
    .m-head { font-size: 20px; }
    .m-para { font-size: 13px; line-height: 1.5; }
    .m-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .m-step { padding: 8px; gap: 6px; }
    .m-body { display: none; }
    .page.is-redesigned .mock {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 30px auto 56px auto auto 1fr;
      /* The copy moves to the top here: it keeps the two notes apart and inside the frame. */
      grid-template-areas: 'nav' 'para' 'img' 'head' 'buy' 'steps';
    }
    .page.is-redesigned .m-head { font-size: 18px; }
    .page.is-redesigned .m-buy { justify-self: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .actions .btn.is-ringing::after { animation: none; }
  }
</style>
