---
/**
 * Brand link used in the header and elsewhere.
 * Defaults to the site root plus #top; the favicon is decorative (empty alt) beside the wordmark.
 */
import { href } from '../config';

interface Props { to?: string }
const { to = href() + '#top' } = Astro.props;
---
<a class="logo" href={to}>
  <span class="tile"><img src={href('favicon.svg')} width="34" height="34" alt="" /></span>
  <span class="word">Kurippu</span>
  <span class="mark"><span lang="ta">குறிப்பு</span> &middot; <span lang="ja">クリップ</span></span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text);
  }
  .logo:hover { color: var(--color-text); }
  .tile {
    width: 34px;
    height: 34px;
    display: block;
    border-radius: 5px;
    transition: transform 0.2s cubic-bezier(0.2, 0.9, 0.3, 1.25), box-shadow 0.2s;
  }
  .tile img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }
  .logo:hover .tile, .logo:focus-visible .tile { transform: rotate(-8deg) translateY(-2px) scale(1.08); box-shadow: var(--shadow-md); }
  .logo:active .tile { transform: scale(0.96); box-shadow: var(--shadow-sm); }
  .word { font: 600 25px/1 var(--font-heading); }
  .mark { font-size: 12px; color: var(--color-neutral-700); letter-spacing: 0.02em; }

  /* Hover/active tile motion is disabled when the visitor prefers reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .tile { transition: none; }
  }
</style>
