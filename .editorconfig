# Shared editor defaults for indentation, line endings, and charset.
# Markdown keeps trailing whitespace so intentional line breaks stay intact.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
